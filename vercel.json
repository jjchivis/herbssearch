{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    {
      "src": "/(.*)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(meta-externalagent|meta-externalfetcher|meta-webindexer).*"
        }
      ],
      "mitigate": {
        "action": "deny"
      }
    }
  ]
}
